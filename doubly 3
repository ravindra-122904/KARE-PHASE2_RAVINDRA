class Node {
    int data;
    Node next, prev;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node n1 = new Node(10);
        Node n2 = new Node(50);
        Node n3 = new Node(30);

        n1.next = n2;
        n2.next = n3;
        n3.next = n1;

        n1.prev = n3;
        n2.prev = n1;
        n3.prev = n2;

        int max = n1.data;
        Node temp = n1.next;

        while (temp != n1) {
            if (temp.data > max) {
                max = temp.data;
            }
            temp = temp.next;
        }

        System.out.println("Maximum = " + max);
    }
}
