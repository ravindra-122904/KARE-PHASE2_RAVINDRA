class Node {
    int data;
    Node prev, next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node a = new Node(10);
        Node b = new Node(50);
        Node c = new Node(30);

        a.next = b;
        b.prev = a;
        b.next = c;
        c.prev = b;

        int max = a.data;
        Node temp = a;

        while (temp != null) {
            if (temp.data > max)
                max = temp.data;

            temp = temp.next;
        }

        System.out.println("Maximum = " + max);
    }
}
