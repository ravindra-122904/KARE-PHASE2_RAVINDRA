// write a java program to implement the bubble sort
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int arr[] = new int[n];
		int i;
		for(i=0;i<n;i++){
		    arr[i] = sc.nextInt();
		}
		System.out.print("the given array of elements are ");
		System.out.println();
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
		int j=0,temp=0;
		for(i=0;i<n;i++){
		    for(j=0;j<n-i-1;j++){
		        if(arr[j]>arr[j+1]){
		            temp = arr[j];
		            arr[j] = arr[j+1];
		            arr[j+1] = temp;
		        }
		    }
		}
		System.out.println();
		System.out.println("The sorted list is");
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
	}
}

