// write a java program to implement the selection sort
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int arr[] = new int[n];
		int i,j,minind;
		for(i=0;i<n;i++){
		    arr[i] = sc.nextInt();
		}
		System.out.print("the given array of elements are ");
		System.out.println();
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
		for(i=0;i<n-1;i++){
		    minind = i;
		    for(j=i+1;j<n;j++)
		    {
		        if(arr[j]<arr[minind])
		        minind =j;
		    }
		    int temp = arr[i];
		    arr[i] = arr[minind];
		    arr[minind] = temp;
		}
		System.out.println();
		System.out.println("The sorted list is");
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
	}
}

