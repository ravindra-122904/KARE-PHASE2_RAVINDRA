// write a java program to implement the selection sort
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int arr[] = new int[n];
		int i;
		for(i=0;i<n;i++){
		    arr[i] = sc.nextInt();
		}
		System.out.print("the given array of elements are ");
		System.out.println();
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
		for(i=1;i<n;i++){
		    int key = arr[i];
		    int j = i-1;
		    while (j>=0 && arr[j]>key)
		    {
		        arr[j+1] = arr[j];
		        j--;
		    }
		    arr[j+1] = key;
		}
		System.out.println();
		System.out.println("The sorted list is");
		for(i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
	}
}

