class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node n1 = new Node(10);
        Node n2 = new Node(20);
        Node n3 = new Node(30);

        n1.next = n2;
        n2.next = n3;
        n3.next = n1;

        Node prev = n3;
        Node current = n1;
        Node next;

        do {
            next = current.next;
            current.next = prev;
            prev = current;
            current = next;
        } while (current != n1);

        n1.next = prev;

        // Print reversed list
        Node temp = prev;

        do {
            System.out.print(temp.data + " ");
            temp = temp.next;
        } while (temp != prev);
    }
}
