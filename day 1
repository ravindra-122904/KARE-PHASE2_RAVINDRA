//write java programe to find the sum of elements in given range
import java.util.Scanner;
public class index {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int s=sc.nextInt();
        int e=sc.nextInt();
        int res=0;
        for(int i=s;i<=e;i++)
            res=res+i;
            System.out.print(res+" ");
    }
}
