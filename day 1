//write java programe to find factorial of a given number
import java.util.Scanner;
public class index {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int s=sc.nextInt();
        int fact=1;
        for(int i=1;i<=s;i++){
            if(s<=0)
                System.out.println("give the number greater than 0");
            fact*=i;
        }System.out.println(fact);

    }
}
//write java programe to print multiplication table
import java.util.Scanner;
public class index {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int s=sc.nextInt();
        for(int i=1;i<=10;i++){
            System.out.println(s+"*"+i+"="+s*i);
        }

    }
}
//write java programe to print multiplication table without *
import java.util.Scanner;
public class index {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int s=sc.nextInt();
        int e=sc.nextInt();
        int sum=0;
        for(int i=1;i<=e;i++){
            sum=sum+s;
            System.out.println(s+"*"+i+"="+sum);
        }

    }
}
