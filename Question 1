class Node {
    int data;
    Node prev, next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node n1 = new Node(10);
        Node n2 = new Node(20);
        Node n3 = new Node(30);

        n1.next = n2;
        n2.prev = n1;

        n2.next = n3;
        n3.prev = n2;

        int sum = 0;
        Node temp = n1;

        while (temp != null) {
            sum = sum + temp.data;
            temp = temp.next;
        }

        System.out.println("Sum = " + sum);
    }
}
