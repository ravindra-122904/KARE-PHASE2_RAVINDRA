// by using the Order of parameters we are Overloading the Method
import java.util.*;
class Main{
    static void print(int a, float b){
        System.out.println(a+" "+b);
    }
    
    static void print(float b,int a){
        System.out.println(b+" "+ a);
    }
    static void print(int a,char c){
        System.out.println(a+" "+ c);
    }
    static void print(char c,int a){
        System.out.println(c+" "+ a);
    }
    static void print(double d,int a){
        System.out.println(d+" "+ a);
    }
    static void print(float b,double d){
        System.out.println(b+" "+ d);
    }
    
    public static void main (String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        float b = sc.nextFloat();
        char c = sc.next().charAt(0);
        double d = sc.nextDouble();
        print(a,b);
        print(b,a);
        print(a,c);
        print(c,a);
        print(d,a);
        print(b,d);
    }
}
