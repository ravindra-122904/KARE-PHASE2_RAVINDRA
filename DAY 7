145
Strong number
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int fact=1,d,temp=n,sum=0;
        while(n!=0){
            fact=1;
            d=n%10;
            for(int i=1;i<=d;i++){
                fact=fact*i;
            }
            sum+=fact;
            n=n/10;
        }
        if (sum==temp)
            System.out.println("Strong number");
        else
            System.out.println("not a Strong number");
    }
}
