class Node {
    int data;
    Node next, prev;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node n1 = new Node(10);
        Node n2 = new Node(20);
        Node n3 = new Node(30);

        n1.next = n2;
        n2.next = n3;
        n3.next = n1;

        n1.prev = n3;
        n2.prev = n1;
        n3.prev = n2;

        // Insert 40
        Node newNode = new Node(40);

        newNode.next = n1;
        newNode.prev = n3;

        n3.next = newNode;
        n1.prev = newNode;

        // Print
        Node temp = n1;

        do {
            System.out.print(temp.data + " ");
            temp = temp.next;
        } while (temp != n1);
    }
}
